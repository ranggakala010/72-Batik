---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	id: string;
	title: string;
	price: string;
	image: ImageMetadata;
	discount?: string;
	rating?: string;
	sales?: string;
	location?: string;
}

const { 
	id, 
	title, 
	price, 
	image, 
	discount = "-53%", 
	rating = "4.9", 
	sales = "2RB+", 
	location = "Kab. Karanganyar" 
} = Astro.props;
---

<article class="group relative bg-white rounded-lg overflow-hidden transition-all duration-500 hover:shadow-2xl hover:shadow-stone-200/50">
	<a href={`/product/${id}`} class="block">
		<div class="aspect-[3/4] overflow-hidden relative">
			<Picture
				src={image}
				alt={title}
				formats={["avif", "webp"]}
				sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
				class="w-full h-full object-cover object-top transition-transform duration-700 scale-100 group-hover:scale-110"
				loading="lazy"
				decoding="async"
			/>
			<div class="absolute inset-0 bg-stone-900/0 group-hover:bg-stone-900/10 transition-colors duration-500"></div>
		</div>
		
		<div class="p-4">
			<div class="flex justify-between items-start mb-0.5">
				<h3 class="text-sm font-medium text-stone-800 group-hover:text-stone-600 transition-colors line-clamp-2 leading-tight">{title}</h3>
			</div>

			<div class="space-y-1 mb-3">
				<div class="flex items-center space-x-2">
					<span class="text-base font-bold text-orange-600">{price}</span>
					<span class="bg-orange-50 text-orange-600 text-[9px] font-bold px-1 py-0.5 rounded">{discount}</span>
				</div>
				
				<div class="flex items-center space-x-2">
					<span class="border border-orange-500 text-orange-600 text-[8px] font-bold px-1 py-0.5 rounded leading-none">Pilih Lokal</span>
				</div>

				<div class="flex items-center text-[10px] font-bold text-stone-600">
					<svg class="w-2.5 h-2.5 text-yellow-500 mr-1" fill="currentColor" viewBox="0 0 20 20">
						<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
					</svg>
					{rating}
					<span class="mx-1 text-stone-300">|</span>
					<span>{sales} Terjual</span>
				</div>

				<div class="flex items-center space-x-2">
					<div class="bg-teal-600 text-white flex items-center px-1 py-0.5 rounded text-[8px] font-bold italic">
						<svg class="w-2 h-2 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
						</svg>
						&lt; 2 Hari
					</div>
					<div class="flex items-center text-[9px] text-stone-400">
						<svg class="w-2.5 h-2.5 mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
						</svg>
						{location}
					</div>
				</div>
			</div>
			
			<div class="flex items-center text-[9px] font-bold uppercase tracking-widest text-stone-800 pt-1.5 border-t border-stone-50">
				<span>Selengkapnya</span>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2 transition-transform duration-300 group-hover:translate-x-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
				</svg>
			</div>
		</div>
	</a>
</article>
