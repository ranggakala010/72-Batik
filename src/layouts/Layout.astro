---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "Koleksi Batik Eksklusif dengan Sentuhan Tradisional dan Modern" } = Astro.props;
import '../styles/global.css';
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} | 72 Batik</title>
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-stone-50 text-stone-900 font-sans selection:bg-stone-200">
		<nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-stone-200 px-6 py-4">
			<div class="max-w-7xl mx-auto flex justify-between items-center">
				<a href="/" class="text-2xl font-serif font-bold text-stone-800 tracking-tighter">72 Batik</a>
				<div class="space-x-8 hidden md:flex font-medium text-sm uppercase tracking-widest text-stone-600">
					<a href="/" class="hover:text-stone-900 transition-colors">Katalog</a>
					<a href="#" class="hover:text-stone-900 transition-colors">Tentang Kami</a>
					<a href="#" class="hover:text-stone-900 transition-colors">Kontak</a>
				</div>
			</div>
		</nav>

		<slot />

		<footer class="py-20 bg-stone-900 text-stone-400 border-t border-stone-800 mt-20">
			<div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-12">
				<div>
					<h3 class="text-white text-xl font-serif font-bold mb-6">72 Batik</h3>
					<p class="text-sm leading-relaxed">Melestarikan warisan budaya Indonesia melalui karya batik berkualitas tinggi untuk gaya hidup modern.</p>
				</div>
				<div>
					<h4 class="text-white font-medium mb-6 uppercase tracking-widest text-xs">Navigasi</h4>
					<ul class="space-y-4 text-sm">
						<li><a href="/" class="hover:text-white transition-colors">Katalog Produk</a></li>
						<li><a href="#" class="hover:text-white transition-colors">Cara Pemesanan</a></li>
						<li><a href="#" class="hover:text-white transition-colors">Lokasi Galeri</a></li>
					</ul>
				</div>
				<div>
					<h4 class="text-white font-medium mb-6 uppercase tracking-widest text-xs">Ikuti Kami</h4>
					<div class="flex space-x-6 text-sm">
						<a href="#" class="hover:text-white transition-colors text-xs uppercase tracking-widest font-bold">Instagram</a>
						<a href="#" class="hover:text-white transition-colors text-xs uppercase tracking-widest font-bold">WhatsApp</a>
					</div>
				</div>
			</div>
			<div class="max-w-7xl mx-auto px-6 mt-20 pt-8 border-t border-white/5 text-center text-xs tracking-widest uppercase">
				&copy; 2026 72 Batik. All rights reserved.
			</div>
		</footer>
	</body>
</html>

<style is:global>
	body {
		font-family: 'Inter', sans-serif;
	}
	h1, h2, h3, .font-serif {
		font-family: 'Playfair Display', serif;
	}
</style>
