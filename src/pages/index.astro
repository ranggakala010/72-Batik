---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';

---

<Layout title="Katalog Produk">
	<header class="relative pt-32 pb-24 px-6 overflow-hidden bg-stone-100">
		<div class="absolute inset-0 opacity-10 pointer-events-none">
			<div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(#8b5e34_1px,transparent_1px)] [background-size:40px_40px]"></div>
		</div>
		
		<div class="max-w-7xl mx-auto text-center relative z-10">
			<span class="text-xs font-bold tracking-[0.3em] uppercase text-stone-500 mb-6 block">Est. 2026</span>
			<h1 class="text-7xl md:text-8xl font-serif font-bold text-stone-900 tracking-tighter mb-8 leading-[0.9]">
				Mahakarya <br class="hidden md:block"/> Batik Indonesia
			</h1>
			<p class="text-xl text-stone-600 max-w-2xl mx-auto font-light leading-relaxed">
				Membawa keanggunan warisan leluhur ke dalam gaya hidup kontemporer dengan kualitas tanpa kompromi.
			</p>
		</div>
	</header>

	<main class="max-w-7xl mx-auto px-6 py-24">
		<div class="flex justify-between items-end mb-16 px-2">
			<div>
				<h2 class="text-xs font-bold tracking-widest text-stone-400 uppercase mb-4">Koleksi Terbaru</h2>
				<p class="text-4xl font-serif font-bold text-stone-800 italic">Signature Series</p>
			</div>
			<div class="hidden md:block">
				<p class="text-stone-400 text-sm italic font-medium">Menampilkan {products.length} karya pilihan</p>
			</div>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 lg:gap-16">
			{products.map((product) => (
				<ProductCard {...product} />
			))}
		</div>
	</main>

	{/* Modular Section Example */}
	<section class="bg-stone-900 py-32 px-6">
		<div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-20 items-center">
			<div class="order-2 md:order-1">
				<img 
					src="/batik 3.jpeg" 
					alt="Craftsmanship" 
					class="rounded-2xl grayscale hover:grayscale-0 transition-all duration-1000 shadow-2xl opacity-60 hover:opacity-100"
				/>
			</div>
			<div class="order-1 md:order-2">
				<h2 class="text-4xl font-serif font-bold text-white mb-8 leading-tight italic">Setiap helaian benang memiliki cerita tersendiri.</h2>
				<p class="text-stone-400 text-lg leading-relaxed mb-10">
					Proses pembuatan batik kami melibatkan ketabahan dan kecintaan yang mendalam. Dari pemilihan kain terbaik hingga sentuhan akhir pengrajin, kami memastikan setiap produk adalah sebuah mahakarya.
				</p>
				<a href="#" class="inline-flex items-center text-xs font-bold tracking-widest uppercase text-white hover:text-stone-300 transition-colors">
					Pelajari Teknik Kami
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
					</svg>
				</a>
			</div>
		</div>
	</section>
</Layout>
