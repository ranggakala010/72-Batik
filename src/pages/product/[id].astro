---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { Picture } from "astro:assets";
import { products } from '../../data/products';

export function getStaticPaths() {
	return products.map((product) => ({
		params: { id: product.id },
		props: { ...product },
	}));
}

const { id } = Astro.params;
const { title, price, image: img, desc, discount, rating, sales, location } = Astro.props;
const whatsappNumber = import.meta.env.PUBLIC_WA_NUMBER ?? "";
const n8nWebhookUrl = import.meta.env.PUBLIC_N8N_WEBHOOK_URL ?? "";
const otherProducts = products.filter((p) => p.id !== id);
---

<Layout title={title}>
	<main class="max-w-7xl mx-auto px-6 py-20">
		<div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">

			{/* ===== KOLOM KIRI: Gambar + Deskripsi ===== */}
			<div class="flex flex-col gap-8">

				{/* Gambar Produk */}
				<div class="relative group overflow-hidden rounded-2xl bg-stone-100 shadow-2xl shadow-stone-200 aspect-square">
					<Picture
						src={img}
						alt={title}
						formats={["avif", "webp"]}
						sizes="(min-width: 1024px) 50vw, 100vw"
						class="w-full h-full object-cover transform transition-transform duration-1000 group-hover:scale-110"
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>

				</div>

				{/* Deskripsi Produk - di bawah gambar */}
				<div class="bg-white rounded-2xl border border-stone-100 shadow-sm overflow-hidden">
					<details class="group" open>
						<summary class="flex justify-between items-center cursor-pointer list-none px-8 py-5 border-b border-stone-100">
							<span class="text-sm font-bold tracking-widest text-stone-900 uppercase">Deskripsi Produk</span>
							<span class="transition-transform duration-300 group-open:rotate-180">
								<svg class="w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
								</svg>
							</span>
						</summary>
						<div class="px-8 py-6 animate-fadeIn">
							<p class="text-stone-800 leading-relaxed text-sm whitespace-pre-line font-medium">
								{desc}
							</p>
						</div>
					</details>

				</div>
			</div>

			{/* ===== KOLOM KANAN: Info & Aksi (Sticky) ===== */}
			<div class="self-start sticky top-32">

				<nav class="mb-8 flex items-center space-x-2 text-xs font-bold tracking-widest text-stone-400 uppercase">
					<a href="/" class="hover:text-stone-800 transition-colors">Katalog</a>
					<span>/</span>
					<span class="text-stone-800">{id}</span>
				</nav>

				<h1 class="text-5xl font-serif font-bold text-stone-900 mb-6 leading-tight">{title}</h1>

				<div class="mb-8">
					<div class="flex items-baseline space-x-3 mb-3">
						<span class="text-3xl font-bold text-orange-600">{price}</span>
						<span class="bg-orange-50 text-orange-600 text-xs font-bold px-2 py-1 rounded">{discount}</span>
					</div>

					<div class="mb-6">
						<span class="border border-orange-500 text-orange-600 text-[10px] font-bold px-3 py-1 rounded inline-block">Pilih Lokal</span>
					</div>

					<div class="flex items-center space-x-3 mb-6">
						<div class="flex items-center text-sm font-bold text-stone-800">
							<svg class="w-4 h-4 text-yellow-500 mr-1" fill="currentColor" viewBox="0 0 20 20">
								<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
							</svg>
							{rating}
						</div>
						<span class="text-stone-300">|</span>
						<span class="text-sm text-stone-600">{sales} Terjual</span>
					</div>

					<div class="flex items-center space-x-4 mb-8">
						<div class="bg-teal-600 text-white flex items-center px-3 py-1 rounded-md text-xs font-bold">
							<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
							</svg>
							&lt; 2 Hari
						</div>
						<div class="flex items-center text-xs text-stone-500">
							<svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
							</svg>
							{location}
						</div>
					</div>
				</div>

				<div class="flex flex-col space-y-4 mb-10">
					<button
						id="wa-button"
						class="w-full py-5 bg-stone-900 text-white rounded-xl hover:bg-stone-800 transition-all transform hover:-translate-y-1 font-bold text-sm tracking-widest uppercase shadow-xl shadow-stone-900/20 flex items-center justify-center gap-2"
						data-wa-number={whatsappNumber}
						data-webhook-url={n8nWebhookUrl}
						data-product-id={id}
						data-product-name={title}
						data-price={price}
						data-currency="IDR"
						data-quantity="1"
						data-event-name="AddToCart"
					>
						<svg class="w-5 h-5 text-green-400" fill="currentColor" viewBox="0 0 24 24">
							<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.414 0 .011 5.403.007 12.04a11.845 11.845 0 001.59 5.925L0 24l6.135-1.61a11.811 11.811 0 005.912 1.586h.005c6.634 0 12.035-5.403 12.04-12.04a11.821 11.821 0 00-3.528-8.521"/>
						</svg>
						Tanya via WhatsApp
					</button>
				</div>

	
			</div>

		</div>
		{/* ===== PRODUK LAINNYA ===== */}
		<section class="mt-24 border-t border-stone-100 pt-16">
			<h2 class="text-2xl font-serif font-bold text-stone-900 mb-10 tracking-tight">Produk Lainnya</h2>
			<div class="grid grid-cols-2 md:grid-cols-4 gap-6">
				{otherProducts.map((product) => (
					<ProductCard
						id={product.id}
						title={product.title}
						price={product.price}
						image={product.image}
						discount={product.discount}
						rating={product.rating}
						sales={product.sales}
						location={product.location}
					/>
				))}
			</div>
		</section>
	</main>
</Layout>

<script is:inline>
const waButton = document.getElementById("wa-button");
if (waButton) {
  waButton.addEventListener("click", async (event) => {
    event.preventDefault();
    const waNumber = waButton.dataset.waNumber || "";
    const webhookUrl = waButton.dataset.webhookUrl || "";
    const productId = waButton.dataset.productId || "";
    const productName = waButton.dataset.productName || "";
    const priceText = waButton.dataset.price || "";
    const currency = waButton.dataset.currency || "IDR";
    const quantity = Number(waButton.dataset.quantity || "1");
    const eventName = waButton.dataset.eventName || "Lead";

    const price = Number(priceText.replace(/[^0-9]/g, "")) || 0;

    const getCookie = (name) => {
      const match = document.cookie.match(new RegExp("(^| )" + name + "=([^;]+)"));
      return match ? decodeURIComponent(match[2]) : "";
    };

    const url = window.location.href;
    const params = new URLSearchParams(window.location.search);
    const utm = {};
    for (const [key, value] of params.entries()) {
      if (key.startsWith("utm_")) utm[key] = value;
    }

    const payload = {
      event_name: eventName,
      event_id: "ev_" + Date.now() + "_" + Math.random().toString(36).slice(2),
      fbp: getCookie("_fbp"),
      fbc: getCookie("_fbc"),
      url,
      utm,
      user_agent: navigator.userAgent,
      ts: new Date().toISOString(),
      form: {
        product_id: productId,
        product_name: productName,
        price,
        currency,
        quantity
      }
    };

    if (window.fbq) {
      try { window.fbq("track", eventName); } catch (_) {}
    }

    const message = `Halo, saya mau tanya produk ${productName}`;
    const waUrl = waNumber
      ? `https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`
      : `https://wa.me/?text=${encodeURIComponent(message)}`;
    window.location.href = waUrl;
  });
}
</script>

<style>
	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(-8px); }
		to   { opacity: 1; transform: translateY(0); }
	}
	.animate-fadeIn {
		animation: fadeIn 0.3s ease-out forwards;
	}
</style>
